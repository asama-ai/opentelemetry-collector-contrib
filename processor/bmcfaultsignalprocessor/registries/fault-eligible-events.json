  "excluded_from_faults": {
    "description": "Normalized events stored but do not open faults",
    "asama_ids": [
      "system.power.on",
      "system.power.off",
      "system.power.cycle",
      "firmware.update.completed",
      "audit.config.changed",
      "audit.user.login",
      "task.completed",
      "bmc.network.changed",
      "security.config.ok",
      "resource.powered_on",
      "resource.powered_off"
    ]
  },
  "deassertion": {
    "description": "Fault raise and clear use the same asama_id. Assert opens a fault; deassert closes the matching open fault. Description pairs below document expected user-facing text; live close text comes from the normalized vendor clear event.",
    "close_match_key": [
      "bmc_ip",
      "asama_id",
      "component_from_component_arg_index"
    ],
    "vendor_clear_signals": {
      "hpe": "Separate MessageId with Oem.Hpe.ClearingLogic or ClearsMessage list",
      "lenovo": "Paired key (often suffix I) with message text 'has deasserted'",
      "dell": "Separate MessageId with Severity OK/Informational and text restored/cleared/recovered"
    }
  }
}

{
  "schema_version": "1.0.0",
  "description": "Asama events that create or clear faults after normalization. Severity comes from asama-bmc-events.json via normalize.py \u2014 not from this file.",
  "fault_rules": {
    "open_on_lifecycle": [
      "assert"
    ],
    "close_on_lifecycle": [
      "deassert",
      "info"
    ],
    "ignore_lifecycle": [
      "unknown"
    ]
  },
  "categories": {
    "power": {
      "description": "PSU, redundancy, input power",
      "events": [
        {
          "asama_id": "power.psu.failure",
          "asama_message_key": "PowerPsuFailure",
          "fault_type": "hardware",
          "create_fault": true,
          "deassert_pair": {
            "same_asama_id": true,
            "assert_lifecycle": "assert",
            "deassert_lifecycle": "deassert",
            "assert_message": "Power supply %1 has failed or is absent.",
            "deassert_message": "Power supply %1 is present and operating normally.",
            "component_arg_index": 1,
            "vendor_clear_message_keys": {
              "hpe": [],
              "dell": [],
              "lenovo": []
            },
            "mapping_note": "Curate assert_mappings and deassert_mappings in the vendor/model/firmware bundle"
